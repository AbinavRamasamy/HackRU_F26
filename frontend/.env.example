# ========================================================
# Backend API Base URL Configuration (Device-Type Aware)
# ========================================================
# 1. For local host on Laptop / Desktop:
VITE_API_BASE_URL_DESKTOP=http://localhost:8000

# 2. For Mobile devices (iOS/Android Capacitor app or mobile browser over LAN):
# Configured to your machine's local Wi-Fi / LAN IP:
VITE_API_BASE_URL_MOBILE=http://10.75.175.144:8000

# 3. Optional Master Override:
# Leave blank to automatically route by device type.
# For production cloud deployment (e.g. https://your-backend.onrender.com):
VITE_API_BASE_URL=

# ========================================================
# Google Maps API Configuration
# ========================================================
# (Optional) Paste your Google Maps API Key below:
# If left blank, the app uses free Google Maps basemap tiles
# and live road routing via the free OSRM routing engine.
VITE_GOOGLE_MAPS_API_KEY=

# (Optional) CARTO API Key
VITE_CARTO_API_KEY=
