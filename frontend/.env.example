# ========================================================
# Backend API Base URL Configuration (Cross-Platform)
# ========================================================
# For local desktop browser development, this defaults to: http://localhost:8000
# For testing on a physical iOS or Android device over local Wi-Fi, set to your computer's LAN IP:
# Example: VITE_API_BASE_URL=http://192.168.1.50:8000
# For production cloud deployment:
# Example: VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=

# ========================================================
# Google Maps API Configuration
# ========================================================
# (Optional) Paste your Google Maps API Key below:
# If left blank, the app uses free Google Maps basemap tiles
# and live road routing via the free OSRM routing engine.
VITE_GOOGLE_MAPS_API_KEY=

# (Optional) CARTO API Key
VITE_CARTO_API_KEY=
