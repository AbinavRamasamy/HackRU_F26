# ==========================================
# ScarletHop Environment Configuration
# ==========================================

# Google Gemini API Key (Required for Schedule Screenshot OCR & AI Copilot Chat)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# ========================================================
# Database Configuration (Hybrid: TigerData or SQLite)
# ========================================================
# (Optional) TigerData Cloud PostgreSQL Connection URI
# If left blank, the backend automatically defaults to local SQLite (sqlite:///./app.db).
# Example TigerData URI:
# DATABASE_URL=postgres://tsdbadmin:your_password@your_tigerdata_host:5432/tsdb?sslmode=require
DATABASE_URL=

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

# Rutgers Live Transitstat.us Endpoint (Preconfigured)
TRANSITSTATUS_API_URL=https://store.transitstat.us/tripshot/rutgers
