# ==========================================
# ScarletHop Environment Configuration
# ==========================================

# Google Gemini API Key (Required for Multimodal Schedule OCR & AI Copilot Chat)
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom Gemini Model override (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend API Port & Host Configuration
PORT=8000
HOST=0.0.0.0

# Live Rutgers Transitstat.us Endpoint (Preconfigured)
TRANSITSTATUS_API_URL=https://store.transitstat.us/tripshot/rutgers
